# Writes BuildInfo.h with the build number (commit count) and commit of the
# source tree. Runs on every build; the header only changes with the commit.
#   cmake -DSOURCE_DIR=<repo> -DOUTPUT=<header> -DVERSION=<x.y.z> -P BuildInfo.cmake

set(build_number 0)
set(commit "dev")
set(commit_date "")

find_package(Git QUIET)

if(GIT_FOUND)
    execute_process(COMMAND ${GIT_EXECUTABLE} rev-list --count HEAD
                    WORKING_DIRECTORY ${SOURCE_DIR} OUTPUT_VARIABLE count
                    OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET RESULT_VARIABLE count_result)
    execute_process(COMMAND ${GIT_EXECUTABLE} rev-parse --short=7 HEAD
                    WORKING_DIRECTORY ${SOURCE_DIR} OUTPUT_VARIABLE hash
                    OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET RESULT_VARIABLE hash_result)
    execute_process(COMMAND ${GIT_EXECUTABLE} log -1 --format=%cs
                    WORKING_DIRECTORY ${SOURCE_DIR} OUTPUT_VARIABLE date
                    OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
    # tracked files only, so ignored local folders never mark a build as modified
    execute_process(COMMAND ${GIT_EXECUTABLE} status --porcelain --untracked-files=no
                    WORKING_DIRECTORY ${SOURCE_DIR} OUTPUT_VARIABLE changes
                    OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)

    if(count_result EQUAL 0 AND hash_result EQUAL 0)
        set(build_number ${count})
        set(commit ${hash})
        set(commit_date ${date})

        if(NOT changes STREQUAL "")
            string(APPEND commit "+")
        endif()
    endif()
endif()

set(content "#pragma once\n\n// Generated by cmake/BuildInfo.cmake - do not edit.\n#define MB11_VERSION \"${VERSION}\"\n#define MB11_BUILD_NUMBER ${build_number}\n#define MB11_BUILD_COMMIT \"${commit}\"\n#define MB11_BUILD_DATE \"${commit_date}\"\n")

if(EXISTS ${OUTPUT})
    file(READ ${OUTPUT} existing)
endif()

if(NOT existing STREQUAL content)
    file(WRITE ${OUTPUT} "${content}")
endif()
